+
+import yaml
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
+WORK_STATES = ("queued", "approved", "started", "completed", "accepted")
+CONDITIONS = ("normal", "blocked", "deferred", "backlog")
